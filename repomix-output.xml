  String _firstName(String username) {
    if (username.isEmpty) return 'there';
    final parts = username.split(RegExp(r'[@._\s]'));
    final first = parts.first;
    return first.isEmpty
        ? username
        : first[0].toUpperCase() + first.substring(1);
  }
}


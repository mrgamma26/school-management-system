              style: TextStyle(fontWeight: FontWeight.bold, fontSize: 15),
            ),
            const SizedBox(height: 8),
            if (avgBySubject.isEmpty)
              const Card(
                child: Padding(
                  padding: EdgeInsets.all(16),
                  child: Text(
                    'No grades recorded yet.',
                    style: TextStyle(color: Colors.grey),
                  ),
                ),
              )
            else
              ...avgBySubject.entries.map((e) {
                final pct = double.tryParse(e.value) ?? 0;
                final color = pct >= 75
                    ? Colors.green
                    : pct >= 50
                    ? Colors.orange
                    : Colors.red;
                return Card(
                  margin: const EdgeInsets.only(bottom: 6),
                  child: Padding(
                    padding: const EdgeInsets.all(12),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Row(
                          children: [
                            Expanded(
                              child: Text(
                                e.key,
                                style: const TextStyle(
                                  fontWeight: FontWeight.bold,
                                ),
                              ),
                            ),
                            Text(
                              '${e.value}%',
                              style: TextStyle(
                                color: color,
                                fontWeight: FontWeight.bold,
                              ),
                            ),
                          ],
                        ),
                        const SizedBox(height: 6),
                        ClipRRect(
                          borderRadius: BorderRadius.circular(4),
                          child: LinearProgressIndicator(
                            value: pct / 100,
                            backgroundColor: color.withValues(alpha: 0.15),
                            valueColor: AlwaysStoppedAnimation<Color>(color),
                            minHeight: 8,
                          ),
                        ),
                      ],
                    ),
                  ),
                );
              }),

            const SizedBox(height: 16),

            // Progression outcomes
            const Text(
              'Progression Outcomes',
              style: TextStyle(fontWeight: FontWeight.bold, fontSize: 15),
            ),
            const SizedBox(height: 8),
            if (progCounts.isEmpty)
              const Card(
                child: Padding(
                  padding: EdgeInsets.all(16),
                  child: Text(
                    'No progression reviews yet.',
                    style: TextStyle(color: Colors.grey),
                  ),
                ),
              )
            else
              ...progCounts.entries.map(
                (e) => Card(
                  margin: const EdgeInsets.only(bottom: 6),
                  child: ListTile(
                    dense: true,
                    leading: CircleAvatar(
                      backgroundColor: _progColor(e.key),
                      radius: 16,
                      child: Icon(
                        _progIcon(e.key),
                        color: Colors.white,
                        size: 14,
                      ),
                    ),
                    title: Text(e.key),
                    trailing: Chip(
                      label: Text('${e.value}'),
                      backgroundColor: _progColor(e.key).withValues(alpha: 0.1),
                    ),
                  ),
                ),
              ),
          ],
        );
      },
    );
  }

  Color _progColor(String d) => switch (d) {
    'APPROVED' => Colors.green,
    'RETAINED' => Colors.orange,
    'REJECTED' => Colors.red,
    _ => Colors.grey,
  };

  IconData _progIcon(String d) => switch (d) {
    'APPROVED' => Icons.check_circle,
    'RETAINED' => Icons.pause_circle,
    'REJECTED' => Icons.cancel,
    _ => Icons.hourglass_empty,
  };
}


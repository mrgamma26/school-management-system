CREATE POLICY "privileged roles read all systemusers"
ON public.systemuser FOR SELECT TO authenticated
USING (
  public.current_app_role() IN (
    'SUPER_USER', 'SYSTEM_ADMIN', 'ADMINISTRATOR', 'REGISTRAR', 'HEAD_TEACHER'
  )
);

-- ─────────────────────────────────────────────────────────────────────────────

// ── Role → home route mapping ────────────────────────────────────────────────

/// Returns the initial route path for a given [role] name (from the database).
String homeForRole(String role) {
  switch (role.trim().toUpperCase()) {
    case 'ADMINISTRATOR':
    case 'REGISTRAR':
      return '/administrator/home';
    case 'TEACHER':
      return '/teacher/home';
    case 'HEAD_TEACHER':
      return '/headteacher/home';
    case 'ACCOUNTANT':
      return '/accountant/home';
    case 'GUARDIAN':
      return '/guardian/home';
    case 'SUPER_USER':
    case 'SYSTEM_ADMIN':
    default:
      return '/admin/home';
  }
}

// ── FIX 5: Role-based route access control ───────────────────────────────────

/// Maps each role to the list of route prefixes they are allowed to access.
/// Used by the router redirect logic to enforce role-based access control.
const Map<String, List<String>> _roleRouteAccess = {
  'SUPER_USER': [
    '/admin/',
    '/administrator/',
    '/teacher/',
    '/headteacher/',
    '/accountant/',
    '/guardian/',
    '/students',
    '/users/',
    '/academics/',
    '/finance/',
    '/calendar',
    '/assessments',
    '/progression/',
    '/weeding/',
    '/notifications',
    '/teacher/comments',
    '/reports',
  ],
  'SYSTEM_ADMIN': [
    '/admin/',
    '/administrator/',
    '/teacher/',
    '/headteacher/',
    '/accountant/',
    '/students',
    '/users/',
    '/academics/',
    '/finance/',
    '/calendar',
    '/assessments',
    '/progression/',
    '/weeding/',
    '/notifications',
    '/teacher/comments',
    '/reports',
  ],
  'ADMINISTRATOR': [
    '/administrator/',
    '/students',
    '/users/',
    '/academics/',
    '/finance/',
    '/calendar',
    '/assessments',
    '/progression/',
    '/weeding/',
    '/notifications',
    '/teacher/comments',
    '/reports',
  ],
  'REGISTRAR': [
    '/administrator/',
    '/students',
    '/users/',
    '/academics/',
    '/calendar',
    '/assessments',
    '/notifications',
  ],
  'HEAD_TEACHER': [
    '/headteacher/',

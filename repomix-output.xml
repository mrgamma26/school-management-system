    try {
      final parts = yearMonth.split('-');
      if (parts.length != 2) return yearMonth;
      final year = parts[0];
      final monthNum = int.parse(parts[1]);
      final months = [
        'January',
        'February',
        'March',
        'April',
        'May',
        'June',
        'July',
        'August',
        'September',
        'October',
        'November',
        'December',
      ];
      return '${months[monthNum - 1]} $year';
    } catch (_) {
      return yearMonth;
    }
  }
}


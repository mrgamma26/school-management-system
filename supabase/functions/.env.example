# Copy this file to supabase/functions/.env for LOCAL function development only.
# The real .env file is ignored by Git. Supabase supplies its own runtime keys.

# Choose the provider used by send-notification-email.
SMTP_USERNAME=your-local-or-test-smtp-username
SMTP_PASSWORD=your-local-or-test-smtp-password

# Never add SUPABASE_SERVICE_ROLE_KEY or a production secret to this example.

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so we do not
# include it in .gitignore. However, the history of project files is not
# relevant and should not be included in version control.
# .vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.packages
/build/
/coverage/

# Local browser/E2E helpers and generated diagnostic output
.tmp_*.mjs
.tmp_*.png
.visible-test-screen.png
*-output.txt
*-error.txt
node_modules/
repomix-output.xml

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment files — never commit secrets
env/dev.json
env/staging.json
env/production.json
users n passwords.txt
supabase/functions/.env
.env
.env.*
!.env.example
!**/.env.example

# Local development tool state
.serena/
supabase/.temp/
supabase/.branches/
.docx_tools/

# Local editor, Office lock files, and one-off test helpers
.vscode/
~$*
*.tmp.ps1

# Mobile Credentials
android/app/key.properties
*.keystore
*.jks
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Internal working documents: kept locally, not published
docs/E2E_*
docs/*Testing_Guide*
docs/School_Workflow_Guide_*
docs/Remaining_Issues_*
docs/superpowers/
docs/*.pdf
users n passwords.txt
